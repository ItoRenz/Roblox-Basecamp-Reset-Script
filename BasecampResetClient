-- ===== EVENT HANDLERS =====

-- Hover effects
toggleButton.MouseEnter:Connect(function()
    local tweenInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    TweenService:Create(toggleButton, tweenInfo, {BackgroundColor3 = Config.Button.Colors.Hover}):Play()
    TweenService:Create(stroke, tweenInfo, {Color = Config.Button.Colors.StrokeHover}):Play()
    TweenService:Create(labelText, tweenInfo, {TextColor3 = Color3.fromRGB(255, 200, 200)}):Play()
    tooltip.Visible = true
end)

toggleButton.MouseLeave:Connect(function()
    local tweenInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    TweenService:Create(toggleButton, tweenInfo, {BackgroundColor3 = Config.Button.Colors.Normal}):Play()
    TweenService:Create(stroke, tweenInfo, {Color = Config.Button.Colors.Stroke}):Play()
    TweenService:Create(labelText, tweenInfo, {TextColor3 = Config.Button.Colors.Normal}):Play()
    tooltip.Visible = false
end)

-- Click animation with pulse effect
toggleButton.MouseButton1Click:Connect(function()
    local originalSize = toggleButton.Size
    local smallerSize = UDim2.new(0, Config.Button.Size * 0.9, 0, Config.Button.Size * 0.9)
    
    -- Pulse down animation
    local pulseDown = TweenService:Create(
        toggleButton,
        TweenInfo.new(0.08, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
        {Size = smallerSize}
    )
    pulseDown:Play()
    
    resetToBasecamp()
    
    -- Pulse back animation with bounce
    pulseDown.Completed:Connect(function()
        TweenService:Create(
            toggleButton,
            TweenInfo.new(0.12, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out),
            {Size = originalSize}
        ):Play()
    end)
    
    -- Flash effect on stroke
    TweenService:Create(stroke, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), 
        {Color = Color3.fromRGB(255, 255, 255), Thickness = 3}):Play()
    
    task.wait(0.15)
    TweenService:Create(stroke, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), 
        {Color = Config.Button.Colors.Stroke, Thickness = 2}):Play()
end)

-- Mobile touch support
toggleButton.TouchTap:Connect(function()
    resetToBasecamp()
end)

