-- ===== SERVICES =====
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

-- ===== VARIABLES =====
local player = Players.LocalPlayer
local mouse = player:GetMouse()
local isMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled

-- ===== REMOTE EVENT SETUP =====
local resetEvent = ReplicatedStorage:FindFirstChild("ResetCheckpointEvent")
if not resetEvent then
    resetEvent = Instance.new("RemoteEvent")
    resetEvent.Name = "ResetCheckpointEvent"
    resetEvent.Parent = ReplicatedStorage
end

-- ===== CONFIGURATION =====
local Config = {
    Button = {
        Size = isMobile and 32 or 36,
        Position = UDim2.new(1, -40, 0, -45),
        Colors = {
            Normal = Color3.fromRGB(255, 107, 107),
            Hover = Color3.fromRGB(255, 85, 85),
            Stroke = Color3.fromRGB(255, 200, 200),
            StrokeHover = Color3.fromRGB(255, 150, 150)
        }
    },
    Label = {
        Position = isMobile and UDim2.new(1, -49, 0, -15) or UDim2.new(1, -47, 0, -10)
    },
    BasecampNames = {"Basecamp", "SpawnLocation", "Base", "Spawn"},
    DefaultSpawn = Vector3.new(0, 50, 0)
}

-- ===== FUNCTIONS =====

-- Find basecamp in workspace
local function findBasecamp()
    for _, name in ipairs(Config.BasecampNames) do
        local found = workspace:FindFirstChild(name)
        if found then return found end
    end
    return nil
end

-- Reset player to basecamp
local function resetToBasecamp()
    local character = player.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then
        warn("⚠️ Character not found or HumanoidRootPart missing")
        return
    end
    
    -- Fire server event to reset checkpoint
    resetEvent:FireServer("ResetCheckpoint")
    
    -- Find and teleport to basecamp
    local basecamp = findBasecamp()
    local hrp = character.HumanoidRootPart
    
    if basecamp then
        local spawnPart = basecamp:IsA("BasePart") and basecamp or basecamp:FindFirstChildWhichIsA("BasePart", true)
        
        if spawnPart and spawnPart:IsA("BasePart") then
            character:MoveTo(spawnPart.Position + Vector3.new(0, 3, 0))
            print("✓ Reset to basecamp successful!")
        else
            character:MoveTo(basecamp:GetPivot().Position + Vector3.new(0, 3, 0))
            print("✓ Reset to basecamp successful (pivot)!")
        end
    else
        character:MoveTo(Config.DefaultSpawn)
        warn("⚠️ Basecamp not found, spawning at default location")
    end
    
    -- Reset physics
    if hrp then
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
        hrp.CFrame = CFrame.new(hrp.Position) * CFrame.Angles(0, hrp.CFrame:ToEulerAnglesYXZ(), 0)
    end
    
    -- Restore health
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.Health = humanoid.MaxHealth
        print("✓ Health restored")
    end
end

