-- ===== SERVICES =====
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

-- ===== CONFIGURATION =====
local Config = {
    CheckpointNames = {"Checkpoint", "CheckPoint", "checkpoint", "CHECKPOINT"},
    SummitNames = {"Summit", "summit", "SUMMIT"},
    ResetValue = 0
}

-- ===== REMOTE EVENT SETUP =====
local resetEvent = ReplicatedStorage:FindFirstChild("ResetCheckpointEvent")
if not resetEvent then
    resetEvent = Instance.new("RemoteEvent")
    resetEvent.Name = "ResetCheckpointEvent"
    resetEvent.Parent = ReplicatedStorage
end

-- ===== FUNCTIONS =====

-- Find stat value by multiple possible names
local function findStat(leaderstats, possibleNames)
    for _, name in ipairs(possibleNames) do
        local stat = leaderstats:FindFirstChild(name)
        if stat and stat:IsA("IntValue") then
            return stat
        end
    end
    return nil
end

-- Reset player checkpoint to basecamp
local function resetPlayerCheckpoint(player)
    local leaderstats = player:FindFirstChild("leaderstats")
    if not leaderstats then
        warn("⚠️ ["..player.Name.."] No leaderstats found")
        return false
    end
    
    -- Reset Checkpoint to 0
    local checkpoint = findStat(leaderstats, Config.CheckpointNames)
    if checkpoint then
        checkpoint.Value = Config.ResetValue
        print("✓ ["..player.Name.."] Checkpoint reset to "..Config.ResetValue.." (SERVER)")
    else
        warn("⚠️ ["..player.Name.."] Checkpoint stat not found")
    end
    
    -- Keep Summit value (don't reset)
    local summit = findStat(leaderstats, Config.SummitNames)
    if summit then
        print("ℹ️ ["..player.Name.."] Summit preserved: "..summit.Value.." (not reset)")
    end
    
    -- Reset RespawnLocation
    player.RespawnLocation = nil
    print("✓ ["..player.Name.."] RespawnLocation reset")
    
    return true
end

-- ===== EVENT HANDLERS =====

resetEvent.OnServerEvent:Connect(function(player, action)
    if action == "ResetCheckpoint" then
        local success = resetPlayerCheckpoint(player)
        
        if success then
            print("✓ ["..player.Name.."] Reset operation completed successfully")
        else
            warn("⚠️ ["..player.Name.."] Reset operation failed")
        end
    else
        warn("⚠️ ["..player.Name.."] Unknown action: "..tostring(action))
    end
end)

-- ===== INITIALIZATION =====
print("✓ Basecamp Reset System Active (SERVER)")
print("✓ Author: ItoRenz00")
print("✓ Listening for reset commands from clients...")
print("✓ Compatible with StatsCore Sequential CP System")
